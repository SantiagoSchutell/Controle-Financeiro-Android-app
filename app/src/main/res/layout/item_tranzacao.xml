<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fundo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/debitoColor">

    <TextView
        android:id="@+id/textValorTranzacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:text="-R$ 52,00"
        android:textColor="@color/verde"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textDescricaoTranzacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Compra em supermercado"
        app:layout_constraintStart_toStartOf="@+id/textValorTranzacao"
        app:layout_constraintTop_toBottomOf="@+id/textValorTranzacao" />

    <TextView
        android:id="@+id/textTipoTranzacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="DEBITO"
        android:textColor="@color/red"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/textValorTranzacao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textValorTranzacao" />

    <TextView
        android:id="@+id/textDataTranzacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="21/07/2026"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/textDescricaoTranzacao"
        app:layout_constraintTop_toBottomOf="@+id/textDescricaoTranzacao" />
</androidx.constraintlayout.widget.ConstraintLayout>